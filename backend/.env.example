# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# SQLite for local dev; use PostgreSQL in production:
# postgresql+asyncpg://facilityos:facilityos@localhost:5432/facilityos
DATABASE_URL=sqlite+aiosqlite:///./facilityos.db

# Comma-separated allowed origins (frontend)
CORS_ORIGINS=["http://localhost:3000"]
